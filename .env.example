# Frontend (Next.js) — copy to .env.local for dev; set real values in Vercel for prod.

# Public API base URL — exposed to the browser.
# Dev:  http://localhost:4000
# Prod: MUST point at the deployed API host (e.g. https://elearning-api.up.railway.app). No trailing slash.
# Reminder: NEXT_PUBLIC_* vars are baked in at build time, so redeploy the frontend after changing this in Vercel.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
