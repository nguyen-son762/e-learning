# Backend (Express + Prisma) — copy to .env for dev; set real values in the API host's secret store for prod.

# Postgres connection used at runtime by the app (Supabase: pooled, port 6543).
# Append ?pgbouncer=true&sslmode=require for Supabase transaction pooler.
DATABASE_URL=

# Postgres direct connection used by prisma migrate (Supabase: direct, port 5432).
DIRECT_URL=

# Long random string to sign JWTs. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional. Defaults to 7d.
JWT_EXPIRES_IN=7d

# App listen port. Most hosts inject this automatically.
PORT=4000

# Comma-separated list of allowed browser origins.
# Dev:  http://localhost:3000
# Prod: MUST equal the deployed Vercel domain, e.g. https://elearning.vercel.app
CORS_ORIGIN=http://localhost:3000
